PORT=8080
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app?schema=public
REDIS_URL=redis://redis:6379
# With REDIS_URL set, the API opens a second connection to subscribe to channel
# "translation:invalidate" (see translate/redis-invalidate-sub.ts) so LRU stays in sync.
TRANSLATION_PROVIDER=stub

# In-process LRU for hot translations (reduces Redis round-trips). 0 = disabled.
TRANSLATION_LRU_MAX=5000

# Set false to skip Postgres reads/writes; cache is LRU + Redis + provider only.
TRANSLATION_DB_PERSIST=true

# BullMQ translation queue (requires REDIS_URL). Set false to run translate inline (no Redis jobs).
TRANSLATION_USE_BULLMQ=true

# On API servers set false and run `npm run worker:translation` separately (see src/worker-translation.ts).
RUN_TRANSLATION_WORKER=true

# BullMQ worker concurrency (parallel translation jobs per worker process).
TRANSLATION_QUEUE_CONCURRENCY=2

# waitUntilFinished timeouts (ms) for queued single / bulk jobs.
TRANSLATION_JOB_TIMEOUT_MS=120000
TRANSLATION_BULK_JOB_TIMEOUT_MS=300000

# Optional delay (ms) before a bulk translateMany call only (smooth bursts). 0 = off.
TRANSLATION_DEBOUNCE_MS=0

# Max strings per provider.translateMany chunk (Google v2 supports batches).
TRANSLATION_BULK_CHUNK=100

# For Google Translate:
# TRANSLATION_PROVIDER=google
# Option A: provide raw service account JSON (recommended for Docker/CI)
# GOOGLE_TRANSLATE_CREDENTIALS_JSON='{"type":"service_account",...}'
# Optional override if not in JSON:
# GOOGLE_TRANSLATE_PROJECT_ID=your-gcp-project-id
#
# Option B: use Application Default Credentials (file path)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json


# Which User fields should be translated at response-time (comma-separated).
TRANSLATABLE_USER_FIELDS=address,notes

# Optional: cleanup stale translation entries when a user updates address/notes.
# WARNING: translations may be shared if multiple users have identical text; for safe cleanup,
# prefer implementing per-user reference tracking. When enabled, this only attempts best-effort cleanup.
TRANSLATION_CLEANUP_ON_USER_UPDATE=false
